# Environment Variables for BlockShare Client
# Copy this file to .env and fill in your actual values

# Pinata API Keys (for IPFS file uploads)
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Smart Contract Address (deployed on your network)
REACT_APP_CONTRACT_ADDRESS=your_contract_address_here
